{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joernott/minecraft-c0de/blob/main/core/src/main/resources/de/joernott/c0de/core/yaml/c0de-program.schema.json",
  "title": "c0de program",
  "description": "A c0de program as the disk drive saves and loads it (docs/concept/17-yaml-format.md).",
  "type": "object",
  "properties": {
    "PROGRAM": {
      "$ref": "#/$defs/name"
    },
    "INCLUDE": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/library"
      }
    },
    "code": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/statement"
      }
    }
  },
  "required": [
    "PROGRAM",
    "code"
  ],
  "additionalProperties": false,
  "$defs": {
    "name": {
      "description": "A valid name: letters, digits and _, starting with a letter, not a keyword (02-language-basics.md).",
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$",
      "not": {
        "enum": [
          "NOOP",
          "PROGRAM",
          "INCLUDE",
          "EXIT",
          "BEGIN",
          "END",
          "BREAK",
          "VARIABLE",
          "CONSTANT",
          "ASSIGN",
          "FUNCTION",
          "PARAMETER",
          "RESULT",
          "RETURN",
          "CALL",
          "IF",
          "ELSE",
          "FOR",
          "EACH",
          "WHILE",
          "REPEAT",
          "BOOLEAN",
          "INTEGER",
          "FLOAT",
          "CHAR",
          "TIME",
          "STRING",
          "ARRAY",
          "HASH",
          "STRUCT",
          "ERROR",
          "LABEL",
          "LITERAL",
          "OPERATOR",
          "COMMENT",
          "TAG",
          "NOT",
          "AND",
          "OR",
          "XOR",
          "TRUE",
          "FALSE"
        ]
      }
    },
    "library": {
      "description": "The name of a library, e.g. c0de/strings.",
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(/[A-Za-z][A-Za-z0-9_]*)+$"
    },
    "qualifiedName": {
      "description": "A name, or the name of an element of a library, e.g. c0de/strings/MID.",
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*(/[A-Za-z][A-Za-z0-9_]*)*$"
    },
    "structName": {
      "$ref": "#/$defs/qualifiedName"
    },
    "label": {
      "description": "A label with its index, e.g. values[i] or position.x.",
      "type": "string",
      "minLength": 1
    },
    "expression": {
      "description": "The tokens of an expression, separated by spaces, without the final ;.",
      "type": "string",
      "minLength": 1
    },
    "literal": {
      "description": "A literal value.",
      "type": [
        "boolean",
        "integer",
        "number",
        "string"
      ]
    },
    "typeName": {
      "enum": [
        "BOOLEAN",
        "INTEGER",
        "FLOAT",
        "CHAR",
        "TIME",
        "STRING",
        "ARRAY",
        "HASH",
        "STRUCT",
        "ERROR"
      ]
    },
    "length": {
      "description": "The length limit of a STRING.",
      "type": "integer"
    },
    "subtype": {
      "description": "The type of the elements of an ARRAY or HASH, without the name of a struct.",
      "type": "string",
      "pattern": "^[A-Z]+( [A-Z0-9]+)*$"
    },
    "tags": {
      "description": "The tags by language, e.g. {json: server.port}.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "comment": {
      "description": "The text of the COMMENT block at the end of the line.",
      "type": "string"
    },
    "disabled": {
      "description": "The blocks after the COMMENT block, as text.",
      "type": "string"
    },
    "statement": {
      "description": "A statement, a NOOP line or a comment line.",
      "type": "object",
      "properties": {
        "keyword": {
          "enum": [
            "NOOP",
            "COMMENT",
            "STRUCT",
            "VARIABLE",
            "CONSTANT",
            "FUNCTION",
            "ASSIGN",
            "CALL",
            "RETURN",
            "EXIT",
            "BREAK",
            "IF",
            "FOR",
            "EACH",
            "WHILE",
            "REPEAT"
          ]
        }
      },
      "required": [
        "keyword"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "keyword": {
                "const": "NOOP"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/noop"
          }
        },
        {
          "if": {
            "properties": {
              "keyword": {
                "const": "COMMENT"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/commentLine"
          }
        },
        {
          "if": {
            "properties": {
              "keyword": {
                "const": "STRUCT"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/struct"
          }
        },
        {
          "if": {
            "properties": {
              "keyword": {
                "const": "VARIABLE"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/declaration"
          }
        },
        {
          "if": {
            "properties": {
              "keyword": {
                "const": "CONSTANT"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/declaration"
          }
        },
        {
          "if": {
            "properties": {
              "keyword": {
                "const": "FUNCTION"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/function"
          }
        },
        {
          "if": {
            "properties": {
              "keyword": {
                "const": "ASSIGN"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/assign"
          }
        },
        {
          "if": {
            "properties": {
              "keyword": {
                "const": "CALL"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/call"
          }
        },
        {
          "if": {
            "properties": {
              "keyword": {
                "const": "RETURN"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/return"
          }
        },
        {
          "if": {
            "properties": {
              "keyword": {
                "const": "EXIT"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/exit"
          }
        },
        {
          "if": {
            "properties": {
              "keyword": {
                "const": "BREAK"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/break"
          }
        },
        {
          "if": {
            "properties": {
              "keyword": {
                "const": "IF"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/if"
          }
        },
        {
          "if": {
            "properties": {
              "keyword": {
                "const": "FOR"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/for"
          }
        },
        {
          "if": {
            "properties": {
              "keyword": {
                "const": "EACH"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/each"
          }
        },
        {
          "if": {
            "properties": {
              "keyword": {
                "const": "WHILE"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/while"
          }
        },
        {
          "if": {
            "properties": {
              "keyword": {
                "const": "REPEAT"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/repeat"
          }
        }
      ]
    },
    "noop": {
      "description": "A NOOP line.",
      "type": "object",
      "properties": {
        "keyword": {
          "const": "NOOP"
        },
        "comment": {
          "$ref": "#/$defs/comment"
        },
        "disabled": {
          "$ref": "#/$defs/disabled"
        }
      },
      "required": [
        "keyword"
      ],
      "additionalProperties": false
    },
    "commentLine": {
      "description": "A line that starts with a COMMENT block.",
      "type": "object",
      "properties": {
        "keyword": {
          "const": "COMMENT"
        },
        "text": {
          "type": "string"
        },
        "disabled": {
          "$ref": "#/$defs/disabled"
        }
      },
      "required": [
        "keyword",
        "text"
      ],
      "additionalProperties": false
    },
    "struct": {
      "description": "A struct declaration.",
      "type": "object",
      "properties": {
        "keyword": {
          "const": "STRUCT"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "code": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/structElement"
          }
        },
        "comment": {
          "$ref": "#/$defs/comment"
        },
        "disabled": {
          "$ref": "#/$defs/disabled"
        }
      },
      "required": [
        "keyword",
        "name",
        "code"
      ],
      "additionalProperties": false
    },
    "structElement": {
      "description": "An element of a struct declaration.",
      "type": "object",
      "properties": {
        "keyword": {
          "const": "ELEMENT"
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "type": {
          "$ref": "#/$defs/typeName"
        },
        "length": {
          "$ref": "#/$defs/length"
        },
        "subtype": {
          "$ref": "#/$defs/subtype"
        },
        "struct": {
          "$ref": "#/$defs/structName"
        },
        "tags": {
          "$ref": "#/$defs/tags"
        },
        "comment": {
          "$ref": "#/$defs/comment"
        },
        "disabled": {
          "$ref": "#/$defs/disabled"
        }
      },
      "required": [
        "keyword",
        "name",
        "type"
      ],
      "additionalProperties": false
    },
    "declaration": {
      "description": "A VARIABLE or CONSTANT.",
      "type": "object",
      "properties": {
        "keyword": {
          "enum": [
            "VARIABLE",
            "CONSTANT"
          ]
        },
        "name": {
          "$ref": "#/$defs/name"
        },
        "type": {
          "$ref": "#/$defs/typeName"
        },
        "length": {
          "$ref": "#/$defs/length"
        },
        "subtype": {
          "$ref": "#/$defs/subtype"
        },
        "struct": {
          "$ref": "#/$defs/structName"
        },
        "value": {
