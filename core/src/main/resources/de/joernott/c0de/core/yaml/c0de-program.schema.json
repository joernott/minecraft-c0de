                "const": "ELEMENT"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/elementLine"
          }
        }
      ]
    },
    "literalLine": {
      "description": "A line of an array initializer: values or a nested initializer.",
      "type": "object",
      "properties": {
        "keyword": {
          "const": "LITERAL"
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/literal"
          }
        },
        "code": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/initializer"
          }
        },
        "comment": {
          "$ref": "#/$defs/comment"
        },
        "disabled": {
          "$ref": "#/$defs/disabled"
        }
      },
      "required": [
        "keyword"
      ],
      "additionalProperties": false
    },
    "elementLine": {
      "description": "An element of a hash or struct initializer: a value or a nested initializer.",
      "type": "object",
      "properties": {
        "keyword": {
          "const": "ELEMENT"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "$ref": "#/$defs/literal"
        },
        "code": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/initializer"
          }
        },
        "comment": {
          "$ref": "#/$defs/comment"
        },
        "disabled": {
          "$ref": "#/$defs/disabled"
        }
      },
      "required": [
        "keyword",
        "name"
      ],
      "additionalProperties": false
    },
    "function": {
