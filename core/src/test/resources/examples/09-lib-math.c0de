// Chapter 09: the library c0de/math
entry: main
expect rounded: 12
expect quotient: -3
expect root: 3.0
expect circle: "3.14"
---
PROGRAM math
NOOP
    INCLUDE c0de/math
    INCLUDE c0de/strings
NOOP
FUNCTION main
    RESULT rounded INTEGER
    RESULT quotient INTEGER
    RESULT root FLOAT
    RESULT circle STRING
BEGIN
    CALL c0de/math/ROUND
        PARAMETER value 12.5 ;
        RESULT result rounded
    CALL c0de/math/DIV
        PARAMETER dividend -7 ;
        PARAMETER divisor 2 ;
        RESULT result quotient
    CALL c0de/math/SQR
        PARAMETER value 9 ;
        RESULT result root
    CALL c0de/strings/FORMAT
        PARAMETER value c0de/math/PI ;
        PARAMETER format "%.2f" ;
        RESULT result circle
END FUNCTION
