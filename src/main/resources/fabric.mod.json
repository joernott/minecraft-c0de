{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "${description}",
  "authors": [
    "${authors}"
  ],
  "contact": {
    "sources": "${sources}",
    "issues": "${issues}"
  },
  "license": "${license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "de.joernott.c0de.platform.fabric.C0deFabric"
    ],
    "client": [
      "de.joernott.c0de.platform.fabric.C0deFabricClient"
    ],
    "fabric-gametest": [
      "de.joernott.c0de.gametest.fabric.FabricGameTests"
    ]
  },
  "mixins": [
    "c0de.mixins.json",
    "c0de-fabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader}",
    "fabric-api": "*",
    "minecraft": "${minecraft}",
    "java": ">=21"
  }
}
